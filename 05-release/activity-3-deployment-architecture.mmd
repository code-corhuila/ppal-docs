    WebBuild["Angular development build - www"]
    NativeBuild["Capacitor sync and Gradle - debug APK"]
    Compose["Docker Compose"]
    Api["REST API - host port 127.0.0.1:3000"]
    Db[("PostgreSQL 17 - private Compose network")]
  end

  AppRepo --> WebBuild
  WebBuild --> NativeBuild
  NativeBuild --> Emulator
  Emulator --> NativeUi
  InfraRepo --> Compose
  ApiRepo --> Compose
  DbRepo --> Compose
  Compose --> Api
  Compose --> Db
  Api --> Db
  Emulator -->|"HTTP via 10.0.2.2:3000 in debug only"| Api
  DocsRepo -. contracts and evidence .-> AppRepo

  subgraph Proposed["Proposed production architecture - NOT deployed"]
    Device["Physical Android / iOS device"]
    Store["Google Play internal track / App Store distribution"]
    Https["HTTPS endpoint and TLS termination"]
    Runtime["Hosted API runtime - provider not selected or provisioned"]
    ManagedDb[("Managed PostgreSQL - private network, not provisioned")]
    AndroidRelease["Signed Android AAB/APK - not generated yet"]
    IosRelease["Signed iOS IPA via macOS/Xcode - not generated"]
    Device -->|"HTTPS API requests"| Https
    Https --> Runtime
    Runtime --> ManagedDb
    AndroidRelease -. proposed upload .-> Store
    IosRelease -. proposed upload .-> Store
    Store -. installation .-> Device
  end

  ReleaseGap["Open release gates: production URL is api.pantrypal.invalid; no release keystore, signed release artifacts, hosted API/database, or store upload are evidenced."]
