flowchart TB
  subgraph Source["GitHub source repositories"]
    AppRepo["ppal-app - Ionic, Angular, Capacitor"]
    ApiRepo["ppal-api - Node.js, Express, TypeScript"]
    DbRepo["ppal-db - PostgreSQL migration and seed"]
